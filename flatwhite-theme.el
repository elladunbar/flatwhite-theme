     `(org-list-dt ((t (:foreground ,base1 :weight bold))))
     `(minibuffer-prompt ((t (:foreground ,base1))))
     `(error ((t (:foreground ,removed :weight bold))))
     `(warning ((t (:foreground ,modified :weight bold))))
     `(success ((t (:foreground ,added :weight bold))))
     `(diff-refine-added ((t (:background ,added :foreground ,base1))))
     `(diff-refine-removed ((t (:background ,removed :foreground ,base1))))
     `(diff-refine-changed ((t (:background ,modified :foreground ,base1))))
     `(diff-refine-header ((t (:foreground ,base3))))
     `(diff-refine-file-header ((t (:foreground ,base1 :weight bold))))
     `(diff-refine-context ((t (:foreground ,base3))))
     `(diff-refine-hunk-header ((t (:foreground ,base3))))
